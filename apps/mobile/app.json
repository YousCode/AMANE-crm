{
  "expo": {
    "name": "Amane",
    "slug": "amane",
    "version": "2.0.0",
    "scheme": "amane",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "fr.amane.crm",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleDisplayName": "Amane",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "fr.amane.crm",
      "adaptiveIcon": {
        "backgroundColor": "#FAF8F4",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "expo-font",
      "expo-audio",
      ["expo-splash-screen", { "image": "./assets/splash-icon.png", "imageWidth": 160, "backgroundColor": "#FAF8F4", "dark": { "backgroundColor": "#111111", "image": "./assets/splash-icon-dark.png" } }],
      ["expo-image-picker", { "photosPermission": "Amane utilise vos photos pour les états des lieux et les messages.", "cameraPermission": "Amane utilise l’appareil photo pour les états des lieux et les messages." }],
      ["expo-notifications", { "icon": "./assets/notification-icon.png", "color": "#111111", "defaultChannel": "amane" }]
    ],
    "experiments": { "typedRoutes": false },
    "extra": {
      "router": {},
      "eas": { "projectId": "00000000-0000-0000-0000-000000000000" }
    }
  }
}
