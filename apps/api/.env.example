# Variables d'environnement de l'API Amane v2 (noms seulement : ne jamais écrire de vraie valeur ici).

# --- Serveur ---
PORT=3000
HOST=0.0.0.0
CRM_ONLY=                   # 1 = projet « CRM seul » : le CRM est servi à la racine (/), le site vitrine n'est pas exposé
PUBLIC_URL=                 # ex. https://amane.example.com — origine du back-office, base des liens publics (/d/:token, espace client, portail prestataire /p/:token)
CORS_ORIGINS=               # origines supplémentaires séparées par des virgules (ex. https://app.amane.example)
CRON_ENABLED=               # 1 sur UNE seule instance : rappels (10 min), alertes (1 h), tableau du lundi (lun. 8 h 30 Paris)
INTERNAL_KEY=               # clé longue pour POST /api/rappels/run, /api/alertes/run, /api/digest/send sans session (en-tête X-Internal-Key)

# --- Base MongoDB Atlas (obligatoire hors FAKE_DB) ---
MONGODB_URI=
MONGODB_DB=amane

# --- Sessions et codes PIN (obligatoire) ---
AUTH_SECRET=                # 32 caractères aléatoires minimum
AMANE_SETUP_CODE=           # code pour créer / réinitialiser les PIN (POST /api/auth/setup)

# --- WhatsApp Cloud API (facultatif : sans, tout le reste fonctionne) ---
WHATSAPP_TOKEN=             # jeton permanent (utilisateur système Meta)
WHATSAPP_PHONE_NUMBER_ID=   # id du numéro WhatsApp Business
WHATSAPP_VERIFY_TOKEN=      # chaîne choisie, saisie dans le webhook Meta
WHATSAPP_APP_SECRET=        # secret de l'app Meta (signature X-Hub-Signature-256)
WHATSAPP_PUBLIC_NUMBER=     # numéro affiché aux clients et aux prestataires (bouton « Poser une question », espace client, portail /p/:token), ex. +33100000000
TEAM_ALERT_NUMBERS=         # ex. amel:33600000001,youssouf:33600000003,aziz:33600000002

# --- IA (facultatif) ---
ANTHROPIC_API_KEY=          # extraction, brouillons, traduction, Majordome, tableau du lundi (503 ia_off sans)
WHISPER_API_KEY=            # clé OpenAI pour la transcription des vocaux (503 transcribe_off sans)

# --- Push Expo (facultatif) ---
EXPO_ACCESS_TOKEN=          # seulement si « Enhanced push security » est activé sur le projet Expo

# --- Pages publiques (facultatif) ---
# L'identité légale des devis et factures (raison sociale, adresse, SIREN, TVA, IBAN, BIC) se saisit dans le
# back-office : Réglages → Documents (document reglages/maison). Les variables ci-dessous ne servent que de repli.
LEGAL_LINE=                 # pied de page de l'espace client
BANK_IBAN=                  # repli si l'IBAN n'est pas saisi dans Réglages → Documents
BANK_BIC=
PUBLIC_PHONE=               # bouton « Appeler » de l'espace client ; repli du téléphone des documents

# --- Développement local seulement ---
FAKE_DB=                    # 1 : base en mémoire, PIN de démo 1234, WhatsApp/Expo simulés, routes /__dev/*
FAKE_AI=                    # 1 : IA et transcription simulées (avec FAKE_DB=1)
DEV_PINS=                   # amel:1234,youssouf:1234,aziz:1234 (défaut) ou none
