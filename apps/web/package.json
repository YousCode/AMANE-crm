{
  "name": "@amane/web",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Amane — back-office web (React + Vite)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:e2e": "node e2e/run.mjs",
    "typecheck": "tsc --noEmit",
    "test:responsive": "node e2e/responsive.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "^6.28.0",
    "zustand": "^5.0.2",
    "@amane/shared": "*"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "msw": "^2.6.8",
    "typescript": "^7.0.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8",
    "@testing-library/dom": "^10.4.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
